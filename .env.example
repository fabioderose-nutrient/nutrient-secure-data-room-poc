# Nutrient license keys. Leave empty to run in evaluation mode.
# Document Engine activation key or offline license key.
ACTIVATION_KEY=
# Web SDK license key, used by the viewer in the browser.
WEB_SDK_LICENSE_KEY=

# Local-only passwords for PostgreSQL and the Document Engine dashboard
# (http://localhost:5720/dashboard, user "dashboard"). Change them.
POSTGRES_PASSWORD=change-me
DASHBOARD_PASSWORD=change-me

# Ports on the host. The browser talks to both.
APP_PORT=4720
DOCUMENT_ENGINE_PORT=5720

# Lifetime of the viewer JWT in seconds. Short on purpose: when it expires,
# Document Engine refuses the token and the viewer closes.
VIEWER_TOKEN_TTL_SECONDS=120

# Optional. Empty = the defaults in brackets. Relative paths start from server/.
# Document Engine URL used by the server [http://localhost:DOCUMENT_ENGINE_PORT].
DE_URL=
# Document Engine URL used by the browser [http://localhost:DOCUMENT_ENGINE_PORT].
DE_EXTERNAL_URL=
# Folder for state.json and audit.jsonl [data/ in the repository].
DATA_DIR=
# Private key that signs the viewing tokens [keys/jwt-private.pem in the repository].
JWT_PRIVATE_KEY_PATH=
